        <div class="support-section">
            <p>Need help with your order?</p>
            <div class="support-links">
                <a href="#" class="support-link">Contact Support</a>
                <a href="#" class="support-link">FAQs</a>
                <a href="#" class="support-link">Return Policy</a>
            </div>
        </div>
    </div>
